# ==============================================================================
# Bruce AI / Orayzis - Root Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS. NEVER COMMIT .env TO GIT.
# ==============================================================================

FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change_this_to_a_random_hex_string_64_characters_min
BRUCE_API_KEY=your_secure_bruce_api_key_here
ADMIN_API_KEY=your_secure_admin_api_key_here
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$placeholder_hash

GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_char_google_app_password

ADE_ICAL_URL=https://aderead.univ-orleans.fr/jsp/custom/modules/plannings/anonymous_cal.jsp?data=YOUR_TOKEN,1
DRIVE_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=0&single=true&output=csv

ALLOWED_ORIGINS=https://orayzis.github.io,https://orayzis.com
RATELIMIT_DEFAULT=60 per minute
PORT=5000
